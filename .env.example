# --- LLM (NVIDIA). Keep the real key out of Git. -------------------------
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=z-ai/glm-5.3,z-ai/glm-5.3-flash,moonshotai/kimi-k3,meta/muse-glimmer-30b
MODEL_FAILURE_THRESHOLD=3
LLM_TIMEOUT_SECONDS=240
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=app-performance-metrics
KAFKA_DLQ_TOPIC=app-performance-metrics-dlq
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=aiops-partition-consumers

# --- PostgreSQL ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://aiops:aiops@postgres:5432/aiops

# --- Collector -----------------------------------------------------------
# seed: use the bundled seed-k8s dataset (no cluster required).
# k8s:  read a live cluster through the Kubernetes API.
COLLECTOR_MODE=seed
SEED_APPS=50
SEED_CLUSTER=demo-cluster
SEED_NAMESPACE=demo
SEED_UNHEALTHY_RATIO=0.08
# Seed telemetry publishes every 120s (collector seed mode and standalone publisher).
SEED_INTERVAL_SECONDS=120
# Interval used when COLLECTOR_MODE=k8s.
COLLECT_INTERVAL_SECONDS=60
# Real clusters:
# COLLECTOR_MODE=k8s
# K8S_CONTEXTS=prod-east,prod-west
# KUBECONFIG=/etc/kube/config

# --- Detection -----------------------------------------------------------
DETECTION_WINDOW_SECONDS=300
INCIDENT_RESOLVE_AFTER_SECONDS=900
THRESH_CPU_RATIO=0.90
THRESH_MEMORY_RATIO=0.90
THRESH_RESTARTS=5
THRESH_GROWTH_RATIO=0.40
THRESH_NODE_CPU_RATIO=0.90
THRESH_NODE_MEMORY_RATIO=0.90

# --- Dashboard -----------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=15

# --- Host port mappings (singleton services only) ------------------------
# collector, consumer and detector publish no host ports, so they can be scaled
# to any replica count:  docker compose up -d --build --scale detector=5
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
INFERENCE_HOST_PORT=9300
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501
# Container-to-container traffic always uses the internal ports, so these
# overrides only affect access from your host.
