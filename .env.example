# --- LLM (NVIDIA). Keep the real key out of Git. -------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=glm-5-3,glm-5-3-flash,kimi-k3,muse-glimmer-30b
MODEL_FAILURE_THRESHOLD=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Kafka ---------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=app-performance-metrics
KAFKA_DLQ_TOPIC=app-performance-metrics-dlq
KAFKA_PARTITIONS=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=aiops-partition-consumers

# --- PostgreSQL ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://aiops:aiops@postgres:5432/aiops

# --- Collector -----------------------------------------------------------
COLLECTOR_MODE=simulated
CLUSTERS=cluster-a,cluster-b,cluster-c
SIMULATED_APPS=120
SIMULATED_UNHEALTHY_RATIO=0.08
COLLECT_INTERVAL_SECONDS=15
# Real clusters:
# COLLECTOR_MODE=k8s
# K8S_CONTEXTS=prod-east,prod-west
# KUBECONFIG=/etc/kube/config

# --- Detection -----------------------------------------------------------
DETECTION_WINDOW_SECONDS=300
INCIDENT_RESOLVE_AFTER_SECONDS=900
THRESH_CPU_RATIO=0.90
THRESH_MEMORY_RATIO=0.90
THRESH_RESTARTS=5
THRESH_GROWTH_RATIO=0.40
THRESH_NODE_CPU_RATIO=0.90
THRESH_NODE_MEMORY_RATIO=0.90

# --- Dashboard -----------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=15

# --- Host port mappings (change to avoid local port conflicts) -----------
# A local PostgreSQL on 5432 is common, so Postgres is published on 5433.
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
COLLECTOR_HOST_PORT=9100
CONSUMER_HOST_PORT=9150
DETECTOR_HOST_PORT=9200
INFERENCE_HOST_PORT=9300
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501
# Container-to-container traffic always uses the internal ports, so these
# overrides only affect access from your host.
